# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MW Cosmetics Admin Panel Passcode
# Configured via environment variable
VITE_ADMIN_PASSCODE="MWCosmetics@2026#Admin"
NEXT_PUBLIC_ADMIN_PASSCODE="MWCosmetics@2026#Admin"

# ---------------------------------------------------------------------------
# FIREBASE CONFIGURATION (From your existing Firebase Console -> Project Settings)
# ---------------------------------------------------------------------------
# Set these in your production host (e.g. Vercel / Netlify / Cloud Run Environment Variables)
# Both VITE_ and NEXT_PUBLIC_ prefixes are supported.
VITE_FIREBASE_API_KEY="AIzaSyDSJsxLIsc-97XdztSnNq1XWr5ne3vQpAw"
VITE_FIREBASE_PROJECT_ID="mwcosmetics"
VITE_FIREBASE_AUTH_DOMAIN="mwcosmetics.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="mwcosmetics.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="85129831851"
VITE_FIREBASE_APP_ID="1:85129831851:web:8fa1148d3eb7221243deee"

# Or alternately as a single JSON string (Firebase Console -> General -> SDK snippet -> Config):
# VITE_FIREBASE_CONFIG='{"apiKey":"AIzaSy...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}'
